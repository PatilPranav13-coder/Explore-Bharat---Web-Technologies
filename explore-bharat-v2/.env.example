# Copy this file to .env and add your own values.
# Never commit .env or expose this key in browser JavaScript.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-6-luna

# Optional PostgreSQL connection string for server-side trip enquiries.
# DATABASE_URL=postgresql://username:password@host:5432/database
# Set true only when your database provider requires SSL.
# DATABASE_SSL=true

PORT=3000
NODE_ENV=development
# Razorpay TEST credentials only. Live keys are deliberately rejected by this demo.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret

# Supabase browser configuration is public (anon key only; never use service_role in config.js).
# Copy config.example.js to config.js and add the project URL and anon/public key there.
