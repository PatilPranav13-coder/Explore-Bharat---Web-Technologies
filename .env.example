# Optional single-user password gate. Leave blank for local-only development.
APP_PASSWORD=
# Use a long random value when APP_PASSWORD is configured.
SESSION_SECRET=
# AI credentials stay on the server. The browser never receives these values.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional request timeout in milliseconds.
AI_TIMEOUT_MS=45000
# Local server defaults to loopback. Set HOST only behind a trusted HTTPS proxy.
HOST=127.0.0.1
PORT=4173
NODE_ENV=development